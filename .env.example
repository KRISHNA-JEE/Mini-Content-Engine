# PostgreSQL connection string
# Local example:   postgresql://postgres:postgres@localhost:5432/mini_content_engine
# Neon/Render etc:  postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_content_engine

# Port the server listens on
PORT=3000

# Set to "true" when connecting to a hosted Postgres that requires SSL (Neon, Render, Supabase, etc.)
DATABASE_SSL=false

# Free Groq API key (used to turn product info into an image-generation prompt).
# Get one at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=
